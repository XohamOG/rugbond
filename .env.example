# Copy to .env. Never commit .env.

# Deployment. Use a testnet-only key.
DEPLOYER_PRIVATE_KEY=

# Leave unset on testnet to deploy a mock WIF and demo coin.
# WIF_ADDRESS=

# Filled in after deployment. Used by the watcher and web app.
RUGBOND_ADDRESS=

# RPC. Must serve chain 46630. Keep private endpoints out of the repo.
RPC_PRIMARY=
RPC_FALLBACK=
RPC_PUBLIC=https://rpc.testnet.chain.robinhood.com

# Watcher: a hot wallet holding a small amount of ETH only.
WATCHER_PRIVATE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
